# API server (Render). Copy to server/.env for local development. In production set these in Render's dashboard.

PORT=4000

# Supabase Postgres connection string. Leave EMPTY locally to use a JSON file (.data/db.json).
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (works over IPv4, which Render needs).
DATABASE_URL=

# Where the website lives. Used for CORS on the live streams, the Google OAuth callback and QR codes.
FRONTEND_URL=http://localhost:3000

# Platform admin (email + password sign-in). Change both before deploying.
ADMIN_EMAIL=admin@vouchiq.test
ADMIN_PASSWORD=admin1234

# Google sign-in. Authorised redirect URI: <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails that become platform admins on sign-in.
ADMIN_EMAILS=

# Demo data. In production the first boot seeds only the category catalogue.
# SEED_DEMO=1    start with the demo businesses (their owner accounts share a KNOWN password)
# DEMO_MODE=1    allow one-click demo sign-in and "Reset to demo data"
