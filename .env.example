# Frontend (Next.js / Vercel). Copy to .env.local. The API server has its own file: server/.env.example

# Where the API server runs. Server-side only: used by the /api/* rewrite and for server rendering.
# Local: http://localhost:4000   Production: your Render URL, e.g. https://wait-kyu-api.onrender.com
# NOTE: on Vercel this is read at BUILD time (rewrites) - set it before deploying.
API_URL=http://localhost:4000

# Same URL, exposed to the browser so live streams (SSE) connect straight to the API host.
NEXT_PUBLIC_API_URL=http://localhost:4000
