# --- Platform admin (email + password sign-in). Change both before any real deployment.
ADMIN_EMAIL=admin@vouchiq.test
ADMIN_PASSWORD=admin1234

# --- Google sign-in (customers, merchants, admins)
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> "Web application"
# Authorised redirect URI:  http://localhost:3000/api/auth/google/callback   (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL, only needed behind a proxy / in production (must match the redirect URI host)
# APP_URL=https://queue.example.com
# Comma-separated Google emails that become platform admins when they sign in
ADMIN_EMAILS=

# --- Optional
# DEMO_MODE=1           allow one-click demo sign-in outside development
# REQUIRE_APPROVAL=1    force admin approval for new businesses (also a toggle in Admin -> Settings)
